# goAthena environment overrides. Copy to .env and edit; env always wins over
# config.yaml. These match the `env:` tags on internal/config.

# --- app ---
APP_NAME=goathena
APP_ENVIRONMENT=development
APP_PORT=8080
APP_SHUTDOWN_TIMEOUT=15s

# --- http control plane ---
HTTP_PORT=8080

# --- persistence (mariadb compat | postgres prod) ---
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ragnarok
DB_USER=ragnarok
DB_PASSWORD=ragnarok
DB_SSL_MODE=disable

# --- valkey (sessions/cache) ---
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# --- nats (event bus) ---
NATS_URL=nats://127.0.0.1:4222

# --- game protocol listeners ---
GATEWAY_LOGIN_PORT=6900
GATEWAY_CHAR_PORT=6121
GATEWAY_MAP_PORT=5121

# --- logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- opentelemetry ---
OTEL_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=goathena
OTEL_TRACES_SAMPLER_ARG=1.0
